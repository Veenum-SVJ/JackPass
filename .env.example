# ── Supabase ────────────────────────────────────────────────────────────────
# Client-side (exposed to the browser via Vite)
VITE_SUPABASE_URL=your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Server-side (Express API server only — never expose to the client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Paystack ─────────────────────────────────────────────────────────────────
PAYSTACK_PUBLIC_KEY=your-public-key
PAYSTACK_SECRET_KEY=your-secret-key
# Optional plan codes for recurring billing
PAYSTACK_PREMIUM_PLAN_CODE=
PAYSTACK_INSTITUTIONAL_PLAN_CODE=

# ── Genkit / Google AI (server-side) ────────────────────────────────────────
GOOGLE_AI_API_KEY=your-google-ai-api-key

# ── OCR (optional — enables real HF OCR; falls back to mock in dev) ────────
HF_TOKEN=

# ── Application ──────────────────────────────────────────────────────────────
# Used as the Paystack callback URL
NEXT_PUBLIC_APP_URL=http://localhost:9002
# Port the production Express server listens on (defaults to 9002)
PORT=9002
