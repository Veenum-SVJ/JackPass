# ── Supabase ────────────────────────────────────────────────────────────────
# Client-side (exposed to the browser via Vite). Vite only exposes VITE_*.
VITE_SUPABASE_URL=your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Server-side mirror — the Express API reads NEXT_PUBLIC_* (it cannot see
# VITE_*). Set the same project URL + anon key here as well.
NEXT_PUBLIC_SUPABASE_URL=your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only — the service-role key bypasses RLS. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Paystack (payments) ──────────────────────────────────────────────────────
PAYSTACK_PUBLIC_KEY=your-public-key
PAYSTACK_SECRET_KEY=your-secret-key
# Optional plan codes for recurring billing
PAYSTACK_PREMIUM_PLAN_CODE=
PAYSTACK_INSTITUTIONAL_PLAN_CODE=

# ── Genkit / Google AI (server-side, metered) ────────────────────────────────
GOOGLE_AI_API_KEY=your-google-ai-api-key

# OCR fallback: mock OCR text is fabricated and is ONLY allowed in
# non-production environments. Set ALLOW_MOCK_OCR=true explicitly to force it
# in a production-like environment (never on the live site).
# HF_TOKEN=                          # legacy HuggingFace OCR — unused with Gemini
ALLOW_MOCK_OCR=

# ── Email digest (server-side) ───────────────────────────────────────────────
RESEND_API_KEY=your-resend-api-key
DIGEST_FROM_EMAIL=JackPass <digest@jackpass.app>
# Shared secret required by the Vercel cron call to /api/cron/weekly-digest.
# Vercel Cron does not attach headers by default — see the deployment docs if
# you need a different trigger mechanism.
CRON_SECRET=replace-with-a-long-random-string

# ── Application ──────────────────────────────────────────────────────────────
# Public URL of the deployed app — used as the Paystack callback URL and in
# emails. Set this to the real production domain.
NEXT_PUBLIC_APP_URL=https://jackpass-vite.vercel.app
# Port the production Express server listens on (defaults to 9002)
PORT=9002
